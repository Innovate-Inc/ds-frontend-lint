# Managed by @innovate/ds-frontend-lint. Do not edit. Change it in ds-frontend-lint instead.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,sln}]
end_of_line = crlf
